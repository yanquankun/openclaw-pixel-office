{
  "name": "openclaw-pixel-agent",
  "description": "Pixel art office visualizing OpenClaw Feishu Bot agent activities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablodelucca/pixel-agents"
  },
  "license": "MIT",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:server && npm run build:webview",
    "dev:server": "tsx --watch server/index.ts",
    "dev:webview": "cd webview-ui && npm run dev",
    "dev": "npm-run-all -p dev:server dev:webview",
    "start": "node dist/server/server/index.js",
    "check-types": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "22.x",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
